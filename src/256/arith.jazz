export
fn gf256_add_u256(reg u256 a, reg u256 b) -> reg u256 {
    reg u256 c;
    c= #VPXOR_256(a, b);
    return c;
}

export
fn gf256_mul(reg u8 a, reg u8 b) -> reg u8 {
    reg u64 x, y, z;
    reg u8 r;
    x = (64u) a;
    y = (64u) b;
    z = __gf256_mul(x, y);
    r = (8u) z;
    return r;
}

export
fn gf256v_mul_u256(reg u256 a, reg u256 b) -> reg u256 {
    reg u256 r;
    r = __gf256v_mul_u256(a, b);
    return r;
}

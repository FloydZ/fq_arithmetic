// GF(2^32), reduction polynomial `MODULUS` from arith.h

u32[1] gf2to32v_mod = { 0x8083 };

// constant time (same as `gf2to32_mul`)
// \return a*b
export
fn gf2to32_mul(reg u32 a, reg u32 b) -> reg u32 {
    inline int i;
    reg u32 bb, r, c, m;

    bb = b;
    r = 0;
    for i = 0 to 32 {
        // r = r*x mod f
        c = r;
        c = c >>s 31;
        c &= 0x8083;
        r += r;
        r ^= c;

        // r += a * b_{31-i}
        m = bb;
        m = m >>s 31;
        m &= a;
        r ^= m;
        bb += bb;
    }
    return r;
}

// \param a: [a_0, ..., a_7]
// \param b: [b_0, ..., b_7]
// \return [a_0*b_0, ..., a_7*b_7]
export
fn gf2to32v_mul_u256(reg u256 a, reg u256 b) -> reg u256 {
    inline int i;
    reg u256 mod, r, c, m, bb;

    mod = #VPBROADCAST_8u32(gf2to32v_mod[0]);

    bb = b;
    r  = #VPSRA_8u32(bb, 31);
    r &= a;
    for i = 1 to 32 {
        // r = r*x mod f
        c  = #VPSRA_8u32(r, 31);
        c &= mod;
        r  = #VPADD_8u32(r, r);
        r ^= c;

        // r += a * b_{31-i}
        bb = #VPADD_8u32(bb, bb);
        m  = #VPSRA_8u32(bb, 31);
        m &= a;
        r ^= m;
    }
    return r;
}

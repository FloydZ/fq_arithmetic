// GF(256^4) = GF(256^2)[X]/(X^2 + X + 256*32), a single element is stored in an uint32_t
require "../256to2/arith.jinc"

u32[1] gf256to4v_low  = { 0x0000FFFF };
u32[1] gf256to4v_high = { 0xFFFF0000 };
u32[1] gf256to4v_mulm = { 0x00002000 };

// (same as `gf256to4_mul`)
// NOTE: a, b < 2^32
// \return a*b
inline
fn __gf256to4_mul(reg u64 a, reg u64 b) -> reg u64 {
    stack u64 sa, sb, sl, sr;
    reg u64 x, y, t, l, r;

    sa = a;
    sb = b;

    // l = a_0*b_0
    x = a;
    x &= 0xFFFF;
    y = b;
    y &= 0xFFFF;
    l = __gf256to2_mul(x, y);
    sl = l;

    // r_0 = l + (256*32)*a_1*b_1
    x = sa;
    x >>= 16;
    y = sb;
    y >>= 16;
    r = __gf256to2_mul(x, y);
    y = 0x2000;
    r = __gf256to2_mul(r, y);
    l = sl;
    r ^= l;
    sr = r;

    // r_1 = (a_0 + a_1)*(b_0 + b_1) + l
    x = sa;
    t = x;
    t >>= 16;
    x ^= t;
    x &= 0xFFFF;
    y = sb;
    t = y;
    t >>= 16;
    y ^= t;
    y &= 0xFFFF;
    r = __gf256to2_mul(x, y);
    l = sl;
    r ^= l;
    r <<= 16;

    t = sr;
    r ^= t;
    return r;
}

// (same as `gf256to4v_mul_u256`)
// \param a: [a_0, ..., a_7]
// \param b: [b_0, ..., b_7]
// \return [a_0*b_0, ..., a_7*b_7]
inline
fn __gf256to4v_mul_u256(reg u256 a, reg u256 b) -> reg u256 {
    stack u256 sab, ssa, ssb, sc;
    reg u256 ab, t, c, m;

    t   = #VPSLL_8u32(a, 16);
    t  ^= a;
    ssa = t;
    t   = #VPSLL_8u32(b, 16);
    t  ^= b;
    ssb = t;

    ab  = __gf256to2v_mul_u256(a, b);
    sab = ab;

    // compute the lower limb
    t = #VPSRL_8u32(ab, 16);
    m = #VPBROADCAST_8u32(gf256to4v_mulm[0]);
    c = __gf256to2v_mul_u256(t, m);
    ab = sab;
    c ^= ab;
    m = #VPBROADCAST_8u32(gf256to4v_low[0]);
    c &= m;
    sc = c;

    // compute the higher limb
    t = ssa;
    m = ssb;
    c = __gf256to2v_mul_u256(t, m);
    ab = sab;
    ab = #VPSLL_8u32(ab, 16);
    c ^= ab;
    m = #VPBROADCAST_8u32(gf256to4v_high[0]);
    c &= m;

    t = sc;
    c ^= t;
    return c;
}

// GF(256^2) = GF(256)[X]/(X^2 + X + 32), a single element is stored in an uint16_t
require "../256/arith.jinc"

u16[1] gf256to2v_low  = { 0x00FF };
u16[1] gf256to2v_high = { 0xFF00 };
u16[1] gf256to2v_mulm = { 0x0020 };

// (same as `gf256to2_mul`)
// NOTE: a, b < 2^16
// \return a*b
inline
fn __gf256to2_mul(reg u64 a, reg u64 b) -> reg u64 {
    stack u64 sa, sb, sl, sr;
    reg u64 x, y, t, l, r;

    sa = a;
    sb = b;

    // l = a_0*b_0
    x = a;
    x &= 0xFF;
    y = b;
    y &= 0xFF;
    l = __gf256_mul(x, y);
    sl = l;

    // r_0 = l + 32*a_1*b_1
    x = sa;
    x >>= 8;
    y = sb;
    y >>= 8;
    r = __gf256_mul(x, y);
    y = 0x20;
    r = __gf256_mul(r, y);
    l = sl;
    r ^= l;
    sr = r;

    // r_1 = (a_0 + a_1)*(b_0 + b_1) + l
    x = sa;
    t = x;
    t >>= 8;
    x ^= t;
    x &= 0xFF;
    y = sb;
    t = y;
    t >>= 8;
    y ^= t;
    y &= 0xFF;
    r = __gf256_mul(x, y);
    l = sl;
    r ^= l;
    r <<= 8;

    t = sr;
    r ^= t;
    return r;
}

// (same as `gf256to2v_mul_u256`)
// \param a: [a_0, ..., a_15]
// \param b: [b_0, ..., b_15]
// \return [a_0*b_0, ..., a_15*b_15]
inline
fn __gf256to2v_mul_u256(reg u256 a, reg u256 b) -> reg u256 {
    stack u256 sab, ssa, ssb, sc;
    reg u256 ab, t, c, m;

    t   = #VPSLL_16u16(a, 8);
    t  ^= a;
    ssa = t;
    t   = #VPSLL_16u16(b, 8);
    t  ^= b;
    ssb = t;

    ab  = __gf256v_mul_u256(a, b);
    sab = ab;

    // compute the lower limb
    t = #VPSRL_16u16(ab, 8);
    m = #VPBROADCAST_16u16(gf256to2v_mulm[0]);
    c = __gf256v_mul_u256(t, m);
    ab = sab;
    c ^= ab;
    m = #VPBROADCAST_16u16(gf256to2v_low[0]);
    c &= m;
    sc = c;

    // compute the higher limb
    t = ssa;
    m = ssb;
    c = __gf256v_mul_u256(t, m);
    ab = sab;
    ab = #VPSLL_16u16(ab, 8);
    c ^= ab;
    m = #VPBROADCAST_16u16(gf256to2v_high[0]);
    c &= m;

    t = sc;
    c ^= t;
    return c;
}

// GF(256^8) = GF(256^4)[X]/(X^2 + X + 65536*256*32), a single element is stored in an uint64_t
require "../256to4/arith.jinc"

u64[1] gf256to8v_low  = { 0x00000000FFFFFFFF };
u64[1] gf256to8v_high = { 0xFFFFFFFF00000000 };
u64[1] gf256to8v_mulm = { 0x0000000020000000 };

// (same as `gf256to8_mul`)
// \return a*b
inline
fn __gf256to8_mul(reg u64 a, reg u64 b) -> reg u64 {
    stack u64 sa, sb, sl, sr;
    reg u64 x, y, t, l, r;
    reg u32 w;

    sa = a;
    sb = b;

    // l = a_0*b_0
    w = (32u) a;
    x = (64u) w;
    w = (32u) b;
    y = (64u) w;
    l = __gf256to4_mul(x, y);
    sl = l;

    // r_0 = l + (65536*256*32)*a_1*b_1
    x = sa;
    x >>= 32;
    y = sb;
    y >>= 32;
    r = __gf256to4_mul(x, y);
    y = 0x20000000;
    r = __gf256to4_mul(r, y);
    l = sl;
    r ^= l;
    sr = r;

    // r_1 = (a_0 + a_1)*(b_0 + b_1) + l
    x = sa;
    t = x;
    t >>= 32;
    x ^= t;
    w = (32u) x;
    x = (64u) w;
    y = sb;
    t = y;
    t >>= 32;
    y ^= t;
    w = (32u) y;
    y = (64u) w;
    r = __gf256to4_mul(x, y);
    l = sl;
    r ^= l;
    r <<= 32;

    t = sr;
    r ^= t;
    return r;
}

// (same as `gf256to8v_mul_u256`)
// \param a: [a_0, ..., a_3]
// \param b: [b_0, ..., b_3]
// \return [a_0*b_0, ..., a_3*b_3]
inline
fn __gf256to8v_mul_u256(reg u256 a, reg u256 b) -> reg u256 {
    stack u256 sab, ssa, ssb, sc;
    reg u256 ab, t, c, m;

    t   = #VPSLL_4u64(a, 32);
    t  ^= a;
    ssa = t;
    t   = #VPSLL_4u64(b, 32);
    t  ^= b;
    ssb = t;

    ab  = __gf256to4v_mul_u256(a, b);
    sab = ab;

    // compute the lower limb
    t = #VPSRL_4u64(ab, 32);
    m = #VPBROADCAST_4u64(gf256to8v_mulm[0]);
    c = __gf256to4v_mul_u256(t, m);
    ab = sab;
    c ^= ab;
    m = #VPBROADCAST_4u64(gf256to8v_low[0]);
    c &= m;
    sc = c;

    // compute the higher limb
    t = ssa;
    m = ssb;
    c = __gf256to4v_mul_u256(t, m);
    ab = sab;
    ab = #VPSLL_4u64(ab, 32);
    c ^= ab;
    m = #VPBROADCAST_4u64(gf256to8v_high[0]);
    c &= m;

    t = sc;
    c ^= t;
    return c;
}

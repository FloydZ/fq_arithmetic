// GF(2^12) = GF(2)[x]/(x^12 + x^3 + 1)

u16[1] gf2to12v_mod = { 0x1009 };

// constant time
// NOTE: a, b < 2^12
// \return a*b
export
fn gf2to12_mul(reg u16 a, reg u16 b) -> reg u16 {
    inline int i;
    reg u64 x, bb, r, c, m;
    reg u16 res;

    x  = (64u) a;
    bb = (64u) b;
    bb <<= 52;
    r = 0;
    for i = 0 to 12 {
        // r = r*x mod x^12 + x^3 + 1
        c = r;
        c >>= 11;
        c = -c;
        c &= 0x1009;
        r <<= 1;
        r ^= c;

        // r += a * b_{11-i}
        m = bb;
        m = m >>s 63;
        m &= x;
        r ^= m;
        bb <<= 1;
    }

    res = (16u) r;
    return res;
}

// NOTE: each element is in a uint16_t
// \param a: [a_0, ..., a_15]
// \param b: [b_0, ..., b_15]
// \return [a_0*b_0, ..., a_15*b_15]
export
fn gf2to12v_mul_u256(reg u256 a, reg u256 b) -> reg u256 {
    inline int i;
    reg u256 mod, r, c, m, bb;

    mod = #VPBROADCAST_16u16(gf2to12v_mod[0]);

    // b_11 is moved into the sign bit
    bb = #VPSLL_16u16(b, 4);
    r  = #VPSRA_16u16(bb, 15);
    r &= a;

    for i = 1 to 12 {
        // r = r*x mod x^12 + x^3 + 1
        c  = #VPSLL_16u16(r, 4);
        c  = #VPSRA_16u16(c, 15);
        c &= mod;
        r  = #VPADD_16u16(r, r);
        r ^= c;

        // r += a * b_{11-i}
        bb = #VPSLL_16u16(bb, 1);
        m  = #VPSRA_16u16(bb, 15);
        m &= a;
        r ^= m;
    }
    return r;
}

// GF(16^3) = GF(16)[X]/(X^3 + X + 1), a single element is stored in an uint16_t
require "../16/arith.jinc"

u16[1] gf16to3v_m0  = { 0x00F };
u16[1] gf16to3v_m1  = { 0x0F0 };
u16[1] gf16to3v_m12 = { 0xFF0 };
u16[1] gf16to3v_m   = { 0xFFF };

// karatsuba (same as `gf16to3_mul`)
//  r_0 = p0 + p1 + p2 + p12
//  r_1 = p0 + p01 + p12
//  r_2 = p0 + p1 + p02
// every product is directly added into all limbs it contributes to
// NOTE: a, b < 2^12
// \return a*b
export
fn gf16to3_mul(reg u16 a, reg u16 b) -> reg u16 {
    reg u64 x, y, s, t, u, p, r;
    reg u16 res;

    x = (64u) a;
    y = (64u) b;

    // p0
    s = x;
    s &= 0xF;
    t = y;
    t &= 0xF;
    p = __gf16_mul(s, t);
    p *= 0x111;
    r = p;

    // p1
    s = x;
    s >>= 4;
    s &= 0xF;
    t = y;
    t >>= 4;
    t &= 0xF;
    p = __gf16_mul(s, t);
    p *= 0x101;
    r ^= p;

    // p2
    s = x;
    s >>= 8;
    s &= 0xF;
    t = y;
    t >>= 8;
    t &= 0xF;
    p = __gf16_mul(s, t);
    r ^= p;

    // p01
    s = x;
    u = x;
    u >>= 4;
    s ^= u;
    s &= 0xF;
    t = y;
    u = y;
    u >>= 4;
    t ^= u;
    t &= 0xF;
    p = __gf16_mul(s, t);
    p <<= 4;
    r ^= p;

    // p12
    s = x;
    s >>= 4;
    u = x;
    u >>= 8;
    s ^= u;
    s &= 0xF;
    t = y;
    t >>= 4;
    u = y;
    u >>= 8;
    t ^= u;
    t &= 0xF;
    p = __gf16_mul(s, t);
    p *= 0x011;
    r ^= p;

    // p02
    s = x;
    u = x;
    u >>= 8;
    s ^= u;
    s &= 0xF;
    t = y;
    u = y;
    u >>= 8;
    t ^= u;
    t &= 0xF;
    p = __gf16_mul(s, t);
    p <<= 8;
    r ^= p;

    res = (16u) r;
    return res;
}

// (same as `gf16to3v_mul_u256`)
// NOTE: each element is stored in an uint16_t, the upper 4 bits must be zero
// \param a: [a_0, ..., a_15]
// \param b: [b_0, ..., b_15]
// \return [a_0*b_0, ..., a_15*b_15]
export
fn gf16to3v_mul_u256(reg u256 a, reg u256 b) -> reg u256 {
    reg u256 pi, p012, x, y, t, r, m;
    stack u256 spi;

    // pi = [p0, p1, p2, 0]
    pi  = __gf16v_mul_u256(a, b);
    spi = pi;

    // [a0^a1, a1^a2, a0^a2, *]
    t = #VPSRL_16u16(a, 4);
    x = a ^ t;
    t = #VPSLL_16u16(a, 8);
    x ^= t;
    t = #VPSRL_16u16(b, 4);
    y = b ^ t;
    t = #VPSLL_16u16(b, 8);
    y ^= t;

    // p012 = [p01, p12, p02, *]
    p012 = __gf16v_mul_u256(x, y);
    pi = spi;

    // r = [0, p0^p12^p01, p1^p0^p02, *]
    r  = #VPSLL_16u16(pi, 4);
    t  = #VPSLL_16u16(pi, 8);
    r ^= t;
    m  = #VPBROADCAST_16u16(gf16to3v_m12[0]);
    t  = p012 & m;
    r ^= t;
    m  = #VPBROADCAST_16u16(gf16to3v_m1[0]);
    t  = #VPSLL_16u16(p012, 4);
    t &= m;
    r ^= t;

    // r_0 = p0^p1^p2^p12
    t  = #VPSRL_16u16(pi, 4);
    t ^= pi;
    x  = #VPSRL_16u16(pi, 8);
    t ^= x;
    x  = #VPSRL_16u16(p012, 4);
    t ^= x;
    m  = #VPBROADCAST_16u16(gf16to3v_m0[0]);
    t &= m;
    r ^= t;

    m  = #VPBROADCAST_16u16(gf16to3v_m[0]);
    r &= m;
    return r;
}
